<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility: query for browser apps (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Firefox variants need explicit package queries for ComponentName targeting -->
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="org.mozilla.fenix.nightly" />
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.focus.beta" />
        <package android:name="org.mozilla.focus.nightly" />
        <package android:name="org.mozilla.klar" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrowserLauncher">

        <!-- Main launcher activity (settings/about) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BrowserLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Browser picker activity - handles link opens -->
        <activity
            android:name=".ui.picker.BrowserPickerActivity"
            android:exported="true"
            android:theme="@style/Theme.BrowserLauncher.Transparent"
            android:excludeFromRecents="true">
            <!-- Register as browser for http/https links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

    </application>

</manifest>
