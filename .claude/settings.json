{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(gradlew:*)",
      "Bash(adb:*)",
      "Read(app/**)",
      "Read(*.gradle.kts)",
      "Read(*.xml)",
